*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.pyre/
.pytype/
.tox/
.nox/
.coverage
htmlcov/
.ipynb_checkpoints/

# ==================================================
# Python 安装与编译产物
# ==================================================
build/
dist/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/

# ==================================================
# Python / Conda 虚拟环境
# ==================================================
.venv/
venv/
env/
ENV/
conda-env/

# ==================================================
# IDE 配置
# ==================================================
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# ==================================================
# 操作系统生成文件
# ==================================================
.DS_Store
Thumbs.db
desktop.ini
*~

# ==================================================
# C/C++ / CMake 编译产物
# ==================================================
*.o
*.obj
*.a
*.so
*.dll
*.dylib

cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# ==================================================
# 临时文件、崩溃文件
# ==================================================
*.tmp
*.temp
*.bak
*.old
nohup.out
core
core.*

# ==================================================
# 工具缓存
# ==================================================
.cache/
cache/
caches/
*.cache
.uv-cache/
torch_extensions/
wandb/

# ==================================================
# 机器人网格资源
#
# Git 只保存 meshes.zip；meshes/ 是本地解压后的运行时目录。
# ==================================================
**/resources/robots/**/meshes/
!**/resources/robots/**/meshes.zip

# MuJoCo 只提交运行所需的精简模型；assert_now 下的导出工程、重复 STL、
# 导出日志和临时 meshes.zip 均不提交。需要的 MJCF/地形会显式强制加入 Git。
mujoco/assert_now/**
mujoco/**/*.STL
mujoco/**/*.stl
mujoco/**/*.zip
mujoco/**/export.log
mujoco/**/MUJOCO_LOG.TXT

# MuJoCo 只提交四个运行脚本实际引用的策略文件；其余实验 ONNX 留在本地。
mujoco/actor/**

# 推胸 MuJoCo 仿真只在本地保留，不提交到仓库。
mujoco/python_tools/*tuixiong*.py

# ==================================================
# 训练生成的视频、帧和调试文件
#
# **/logs/ 表示匹配任意目录层级中的 logs
# ==================================================
**/logs/**/video/
**/logs/**/videos/
**/logs/**/frames/
**/logs/**/recordings/
**/logs/**/debug/
**/logs/**/tmp/
**/logs/**/wandb/

**/logs/**/*.mp4
**/logs/**/*.avi
**/logs/**/*.mov
**/logs/**/events.out.tfevents.*

**/logs/**/*.zip
**/logs/**/*.tar
**/logs/**/*.tar.gz
**/logs/**/*.tgz
**/logs/**/*.7z
# ==================================================
# 训练 checkpoint
#
# 默认忽略所有自动编号的模型。
# 每个日志目录只保留最新且非第 0 轮的模型，需要使用 git add -f 添加。
# ==================================================
**/logs/**/model_*.pt
**/logs/**/checkpoint_*.pt

**/logs/**/model_*.pth
**/logs/**/checkpoint_*.pth

**/logs/**/model_*.ckpt
**/logs/**/checkpoint_*.ckpt

# ==================================================
# 以下内容没有被忽略，会正常保存：
#
# 源码
# 配置文件
# URDF、压缩后的网格和其他资源文件
# ONNX模型
# YAML / JSON / CSV
# PNG训练曲线
# ==================================================
